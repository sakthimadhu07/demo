      <name>WebTable_URL</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description></description>
      <initValue>'https://practice.expandtesting.com/dynamic-table'</initValue>
      <name>InsideWebTable_URL</name>
   </GlobalVariableEntity>
</GlobalVariableEntities>
